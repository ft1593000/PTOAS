// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s

module {
  func.func @f16_to_ui8_vl1(
      %src: !pto.ptr<f16, ub>, %dst: !pto.ptr<ui8, ub>, %offset: index) {
    %value = pto.vmi.vload %src[%offset]
        : !pto.ptr<f16, ub> -> !pto.vmi.vreg<1xf16>
    %converted = pto.vmi.vcvt %value {saturate = "SAT"}
        : !pto.vmi.vreg<1xf16> -> !pto.vmi.vreg<1xui8>
    pto.vmi.vstore %converted, %dst[%offset]
        : !pto.vmi.vreg<1xui8>, !pto.ptr<ui8, ub>
    return
  }

  func.func @f16_to_ui8_vl2(
      %src: !pto.ptr<f16, ub>, %dst: !pto.ptr<ui8, ub>, %offset: index) {
