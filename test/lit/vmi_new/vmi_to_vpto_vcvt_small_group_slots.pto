  func.func @ensure_contiguous_to_single_slot_group_f32(
      %value: !pto.vmi.vreg<2xf32, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<2xf32, #pto.vmi.layout<num_groups = 2, slots = 1>> {
    %result = pto.vmi.ensure_layout %value
        : !pto.vmi.vreg<2xf32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<2xf32, #pto.vmi.layout<num_groups = 2, slots = 1>>
    return %result
        : !pto.vmi.vreg<2xf32, #pto.vmi.layout<num_groups = 2, slots = 1>>
  }

  func.func @ensure_group_slots8_to_lane_stride2_f16(
      %value: !pto.vmi.vreg<8xf16,
          #pto.vmi.layout<num_groups = 8, slots = 8>>)
      -> !pto.vmi.vreg<8xf16,
          #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 2>> {
    %result = pto.vmi.ensure_layout %value
        : !pto.vmi.vreg<8xf16,
            #pto.vmi.layout<num_groups = 8, slots = 8>>
        -> !pto.vmi.vreg<8xf16,
