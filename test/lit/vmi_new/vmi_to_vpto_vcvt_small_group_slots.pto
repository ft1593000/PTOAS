        : !pto.vmi.vreg<8xf32,
            #pto.vmi.layout<num_groups = 8, slots = 8>>
        -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<contiguous>>
    %result = pto.vmi.ensure_layout %contiguous
        : !pto.vmi.vreg<8xf32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<8xf32,
            #pto.vmi.layout<num_groups = 8, slots = 8>>
    return %result
        : !pto.vmi.vreg<8xf32,
            #pto.vmi.layout<num_groups = 8, slots = 8>>
  }
